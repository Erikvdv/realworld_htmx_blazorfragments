@using Markdig
@using RealworldBlazorHtmx.App.ServiceClient

@code {

    public static RenderFragment RenderArticle(Article article, User? user) =>
        @<div class="article-page" id="articlepage">
            <div class="banner">
                <div class="container">
                    <h1>@article.Title</h1>

                    <div class="article-meta">
                        <a href="/profile/?author=@article.Author.Username">
                            <img src="@article.Author.Image"/>
                        </a>
                        <div class="info">
                            <a href="/profile/?author=@article.Author.Username"
                               class="author">
                                @article.Author.Username
                            </a>
                            <span class="date">@article.UpdatedAt.ToString("MMMM d, yyyy")</span>
                        </div>
                        @if (user is not null && user.Username == article.Author.Username)
                        {
                            <a href="/editor/@article.Slug">
                                <button class="btn btn-sm btn-outline-secondary">
                                    <i class="ion-edit"></i> Edit Article
                                </button>
                            </a>
                            <button class="btn btn-sm btn-outline-danger" hx-delete="/article/@article.Slug">
                                <i class="ion-trash-a"></i> Delete Article
                            </button>
                        }
                        else
                        {
                            @RenderArticleAuthor(article.Author)

                            @if (article.Favorited)
                            {
                                <button class="btn btn-sm btn-primary" hx-delete="/article/@article.Slug/favorite"
                                        hx-target="#articlepage">
                                    <i class="ion-heart"></i>
                                    Unfavorite Article <span class="counter">(@article.FavoritesCount)</span>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" hx-post="/article/@article.Slug/favorite"
                                        hx-target="#articlepage">
                                    <i class="ion-heart"></i>
                                    Favorite Article <span class="counter">(@article.FavoritesCount)</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="container page">
                <div class="row article-content">
                    <div class="col-md-12">
                        @((MarkupString) GetHtml(article.Description))
                        @((MarkupString) GetHtml(article.Body))
                        <ul class="tag-list">
                            @foreach (var tag in article.TagList)
                            {
                                <li class="tag-default tag-pill tag-outline">@tag</li>
                            }
                        </ul>
                    </div>
                </div>

                <hr/>
                @if (user is not null)
                {
                    <div class="col-xs-12 col-md-8 offset-md-2">
                        <div hx-get="/article/@article.Slug/comments" hx-trigger="load" id="commentlist"></div>
                    </div>
                }

            </div>
        </div>;


    public static RenderFragment RenderArticleAuthor(Profile profile) =>
        @<text>
             @if (profile.Following)
             {
                 <button class="btn btn-sm action-btn btn-secondary" hx-delete="/article/followauthor/@profile.Username" hx-swap="outerHTML">
                     <i class="ion-plus-round"></i>
                     &nbsp; Unfollow @profile.Username
                 </button>
             }
             else
             {
                 <button class="btn btn-sm btn-outline-secondary" hx-post="/article/followauthor/@profile.Username" hx-swap="outerHTML">
                     <i class="ion-plus-round"></i>
                     &nbsp; Follow @profile.Username
                 </button>
             }
        </text>;

    public static RenderFragment RenderComments(string articleSlug, List<Comment> comments, User user) =>
        @<text>
             <form class="card comment-form" hx-post="/article/@articleSlug/comments" hx-include="[name='comment']" hx-target="#commentlist">
                 <div class="card-block">
                     <textarea class="form-control" placeholder="Write a comment..." rows="3" name="comment"></textarea>
                 </div>
                 <div class="card-footer">
                     <img src="@user.Image" class="comment-author-img"/>
                     <button class="btn btn-sm btn-primary">Post Comment</button>
                 </div>
             </form>
             @foreach (var comment in comments)
             {
                 @RenderComment(comment, user.Username, articleSlug)
             }
    </text>;

    private static RenderFragment RenderComment(Comment comment, string username, string articleSlug) => 
        @<div class="card">
           <div class="card-block">
               <p class="card-text">
                   @comment.Body
               </p>
           </div>
           <div class="card-footer">
               <a href="/profile/?author=@comment.Author" class="comment-author">
                   <img src="@comment.Author.Image" class="comment-author-img"/>
               </a>
               &nbsp;
               <a href="/profile/?author=@comment.Author.Username" class="comment-author">@comment.Author.Username</a>
               <span class="date-posted">@comment.UpdatedAt</span>
               @if (comment.Author.Username == username)
               {
                   <span class="mod-options">
                       <i class="ion-trash-a" hx-delete="/article/@articleSlug/comments/@comment.Id" hx-target="#commentlist"></i>
                   </span>
               }
           </div>
        </div>;
    private static string GetHtml(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder()
            .UseSoftlineBreakAsHardlineBreak()
            .Build();
        return Markdown.ToHtml(markdown, pipeline);
    }

}