@using RealworldBlazorHtmx.App.Features.Shared
@using RealworldBlazorHtmx.App.Features.Shared.Articles
@code {

    public static RenderFragment RenderHome(bool isAuthenticated, ArticlesFilter filter) =>
        @<div class="home-page">
            @if (!isAuthenticated)
            {
                <div class="banner">
                    <div class="container">
                        <h1 class="logo-font">conduit</h1>
                        <p>A place to share your knowledge.</p>
                    </div>
                </div>
            }

            <div class="container page">
                <div class="row">
                    <div class="col-md-9">
                        @ArticlesFragments.RenderArticles(isAuthenticated, filter)
                    </div>

                    <div class="col-md-3">
                        <div class="sidebar" hx-get="/home/tags" hx-trigger="load">Loading tags...</div>
                    </div>
                </div>
            </div>
        </div>;
    
    public static RenderFragment RenderTags(List<string> tags) =>
        @<div class="sidebar">
            <p>Popular Tags</p>
            <div class="tag-list" id="taglist">
                @foreach (var tag in tags)
                {
                    <a class="tag-default tag-pill" href="?page=1&tag=@tag">@tag</a>
                }
            </div>
        </div>;

}