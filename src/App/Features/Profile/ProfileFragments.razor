@using RealworldBlazorHtmx.App.Features.Shared.Articles
@using RealworldBlazorHtmx.App.ServiceClient
@code {

    public static RenderFragment RenderProfile(bool isAuthenticated, Profile profile,
        ArticlesFilter filter, bool isSelf) =>
        @<div class="profile-page">
            <div class="user-info">
                <div class="container">
                    <div class="row">
                        <div class="col-xs-12 col-md-10 offset-md-1">
                            <img src="@profile.Image" class="user-img"/>
                            <h4>@profile.Username</h4>
                            <p>
                                @profile.Bio
                            </p>
                            @if (isSelf)
                            {
                                <a href="/settings">
                                    <button class="btn btn-sm btn-outline-secondary action-btn">
                                        <i class="ion-gear-a"></i>
                                        &nbsp; Edit Profile Settings
                                    </button>
                                </a>
                            }
                            else
                            {
                                @RenderProfileFollowing(profile)
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="container">
                <div class="row">
                    <div class="col-xs-12 col-md-10 offset-md-1">
                        @ArticlesFragments.RenderArticles(isAuthenticated, filter)
                    </div>
                </div>
            </div>
        </div>;

    public static RenderFragment RenderProfileFollowing(Profile profile)
    {
        if (profile.Following)
        {
            return @<button class="btn btn-sm action-btn btn-secondary" hx-delete="/profile/@profile.Username/follow"
                            hx-swap="outerHTML">
                <i class="ion-plus-round"></i>
                &nbsp; Unfollow @profile.Username
            </button>;
        }

        return @<button class="btn btn-sm btn-outline-secondary action-btn" hx-post="/profile/@profile.Username/follow"
                        hx-swap="outerHTML">
            <i class="ion-plus-round"></i>
            &nbsp; Follow @profile.Username
        </button>;
    }

}